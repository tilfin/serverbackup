#
# Sync script path
#
# Usage: <script> <srcdir> <bucket> <destdir>
#
#Sync=/backup/serverbackup/sync.gcloud

#
# Backup command directory
#
# Executes each command with prefix 'S' in this directory
#
#BackupCmdDir=/backup/serverbackup/bkcmd.d

#
# Existing parent directory for private per-run backup work directories.
# It must be owned by the backup user with no group/other write permission,
# or be a root-owned sticky directory such as /tmp.
#
BackupTmpDir=/backup/tmp

#
# Log directory
#
LogDir=/backup/log

#
# Buckets of Cloud storage
#
#
#Buckets=backup
#Buckets=asia,us,eu
Buckets=

#
# Folder name which is root path of bucket
#
DestDir=`hostname`

#
# Days for which you desire to save cloud
#
MaxAge=5

#
# Days for which you desire to save logfiles
#
MaxLogAge=20
